        "#imports\n",
        "from datetime import datetime\n",
        "\n",
        "#file open/create\n",
        "file = open(\"logs.txt\", \"w\")\n",
        "file.close()\n",
        "\n",
        "#database\n",
        "user = \"admin\"\n",
        "password = \"admin1234\"\n",
        "\n",
        "#variables\n",
        "attempts = int(\"1\")\n",
        "\n",
        "#logs\n",
        "def logs(message):\n",
        " timelog = (datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"))\n",
        " time = (f\"[{timelog}] - \")\n",
        "\n",
        " file = open (\"logs.txt\", \"a\")\n",
        " file.write (str(time) + message + \"\\n\")\n",
        " file.close()\n",
        "\n",
        "#logs loop\n",
        "while True:\n",
        " user_input = input(\"User: \")\n",
        " password_input = input(\"Password: \")\n",
        "\n",
        "#successful login\n",
        " if user_input == user and password_input == password:\n",
        "  print(\"Acess granted.\")\n",
        "  logs(f\"ACESS GRANTED. - Attempt{attempts}/3\\n-user:{user_input}\\n-password:{password_input}\\n\")\n",
        "  break\n",
        "\n",
        "#failed login\n",
        " else:\n",
        "  print(\"Acess denied.\")\n",
        "  print(\"===============\")\n",
        " logs(f\"ACESS DENIED. - Attempt{attempts}/3\\n-user:{user_input}\\n-password:{password_input}\\n\")\n",
        "\n",
        " attempts = (attempts)+1\n",
        "\n",
        "\n",
        "#user blocked\n",
        " if attempts == 4:\n",
        "  print(\"Error...\\nToo many failed attempts. Try again later.\")\n",
        "  logs(f\"ACESS BLOCKED. - Attempt{attempts-1}/3\\n-user:{user_input}\\n-password:{password_input}\")\n",
        "  break"
      ]
    }
  ]
