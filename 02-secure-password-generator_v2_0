#background
import random
letters = list("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
numbers = list("12345678901234567890123456789012345678901234567890")
special = list("!@#$%^&*()-_=+?!@#$%^&*()-_=+?!@#$%^&*()-_=+?")
characters = letters + numbers + special
cont = 0
password = ""
num = ""

#user data
while True:
 try:
  print("How many characters do you want in your password?")
  num = int(input("Answer: "))
  if num in range(1,31):
   break
  else:
    print("\nTry a number beetween 1 and 30.")
 except:
   print("\nInvalid character, try again with numbers.")

#password
while num > cont:
 ger = random.choice(characters)

 password = (password)+(ger)

 cont = cont+1

 if num == cont:
  print("\nPassword generated successfully:")
  print(f"{password}")
